//PROMELIG JOB (MANPWR),'PROM ELIG NIGHTLY',CLASS=A,MSGCLASS=X,
//             REGION=0M,NOTIFY=&SYSUID
//*
//* NIGHTLY PROMOTION ELIGIBILITY DETERMINATION
//* RUNS AFTER UNIT DIARY LOAD.  DO NOT RUN STANDALONE -- THE
//* MASTER MUST BE CURRENT OR THE BOARD SLATE WILL BE STALE.
//*
//JOBLIB   DD DSN=MANPWR.PROD.LOADLIB,DISP=SHR
//*
//STEP010  EXEC PGM=IEFBR14
//DELOLD   DD DSN=MANPWR.PROD.ELIG.EXTRACT,
//            DISP=(MOD,DELETE,DELETE),
//            SPACE=(TRK,(1,1)),UNIT=SYSDA
//*
//STEP020  EXEC PGM=SORT,COND=(0,NE)
//SORTIN   DD DSN=MANPWR.PROD.MASTER,DISP=SHR
//SORTOUT  DD DSN=&&SORTED,DISP=(NEW,PASS),
//            SPACE=(CYL,(50,10),RLSE),UNIT=SYSDA
//SYSIN    DD *
  SORT FIELDS=(1,10,ZD,A)
  INCLUDE COND=(58,2,ZD,LT,09)
/*
//*
//STEP030  EXEC PGM=PROMELIG,COND=(0,NE)
//MSTRIN   DD DSN=&&SORTED,DISP=(OLD,DELETE)
//ELIGOUT  DD DSN=MANPWR.PROD.ELIG.EXTRACT,
//            DISP=(NEW,CATLG,DELETE),
//            SPACE=(CYL,(50,10),RLSE),UNIT=SYSDA,
//            DCB=(RECFM=FB,LRECL=60,BLKSIZE=0)
//RPTOUT   DD SYSOUT=*
//SYSOUT   DD SYSOUT=*
//SYSUDUMP DD SYSOUT=X
//*
//* STEP040 REFRESHES THE REPORTING EXTRACT VIA SP_PROMOTION_ELIGIBILITY.
//* THE STORED PROCEDURE READS THE MASTER DIRECTLY -- IT DOES NOT READ
//* ELIGOUT.  THE TWO ARE EXPECTED TO AGREE.
//*
//STEP040  EXEC PGM=IKJEFT01,COND=(0,NE)
//SYSTSPRT DD SYSOUT=*
//SYSTSIN  DD *
  DSN SYSTEM(DSNP)
  RUN PROGRAM(DSNTEP2) PLAN(DSNTEP2)
/*
//
